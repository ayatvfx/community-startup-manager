<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Community Startup Manager" Width="1060" Height="720"
        MinWidth="830" MinHeight="580" WindowStartupLocation="CenterScreen"
        Background="#F5F5F7" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <Style x:Key="RoundedButton" TargetType="Button">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#E5E5EA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="15,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.82"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PlainListItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="30,22,30,18" Background="#F5F5F7">
    <Grid.RowDefinitions>
      <RowDefinition Height="93"/>
      <RowDefinition Height="64"/>
      <RowDefinition Height="66"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="72"/>
      <RowDefinition Height="50"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="STARTUP MANAGER" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold"/>
        <TextBlock Text="Your startup apps" Foreground="#1D1D1F" FontSize="29" FontWeight="SemiBold" Margin="0,1,0,0"/>
        <TextBlock Text="A calmer way to choose what opens when you sign in." Foreground="#6E6E73" FontSize="13" Margin="0,2,0,0"/>
      </StackPanel>
      <Border Grid.Column="1" Background="White" CornerRadius="12" BorderBrush="#E5E5EA"
              BorderThickness="1" Padding="15,8" VerticalAlignment="Top" Margin="0,7,0,0">
        <TextBlock Text="CURRENT USER" Foreground="#6E6E73" FontSize="11" FontWeight="SemiBold"/>
      </Border>
    </Grid>

    <Grid Grid.Row="1" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" BorderBrush="#E5E5EA" BorderThickness="1"
              CornerRadius="11" Margin="0,0,12,0" Padding="13,0">
        <DockPanel LastChildFill="True" VerticalAlignment="Center">
          <TextBlock Text="⌕" FontSize="21" Foreground="#9A9AA0" Margin="0,-3,9,0" DockPanel.Dock="Left"/>
          <Grid>
            <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                     Foreground="#1D1D1F" FontSize="13" VerticalContentAlignment="Center"
                     ToolTip="Search names, commands, and paths"/>
            <TextBlock x:Name="SearchHint" Text="Search apps and paths" Foreground="#A0A0A5"
                       VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False"/>
          </Grid>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Background="#E9E9ED" CornerRadius="11" Padding="3" Margin="0,0,12,0">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="AllButton" Content="All" Width="62" Style="{StaticResource RoundedButton}" BorderThickness="0" Padding="8,7"/>
          <Button x:Name="EnabledButton" Content="On" Width="62" Style="{StaticResource RoundedButton}" BorderThickness="0" Padding="8,7"/>
          <Button x:Name="DisabledButton" Content="Off" Width="62" Style="{StaticResource RoundedButton}" BorderThickness="0" Padding="8,7"/>
        </StackPanel>
      </Border>
      <Button x:Name="RefreshButton" Grid.Column="2" Content="Refresh" Style="{StaticResource RoundedButton}" Margin="0,0,8,0"/>
      <Button x:Name="BackupButton" Grid.Column="3" Content="Backups" Style="{StaticResource RoundedButton}"/>
    </Grid>

    <Grid Grid.Row="2" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" CornerRadius="11" BorderBrush="#ECECEF" BorderThickness="1" Padding="15,8">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="TotalCount" Text="0" Foreground="#1D1D1F" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="  total apps" Foreground="#6E6E73" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="White" CornerRadius="11" BorderBrush="#ECECEF" BorderThickness="1" Padding="15,8">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="EnabledCount" Text="0" Foreground="#16825D" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="  on" Foreground="#6E6E73" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="4" Background="White" CornerRadius="11" BorderBrush="#ECECEF" BorderThickness="1" Padding="15,8">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="DisabledCount" Text="0" Foreground="#A56A30" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="  off" Foreground="#6E6E73" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="3">
      <Grid.RowDefinitions><RowDefinition Height="27"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="STARTUP ITEMS" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold"/>
      <ListBox x:Name="ItemList" Grid.Row="1" Background="Transparent" BorderThickness="0"
               ItemContainerStyle="{StaticResource PlainListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    </Grid>

    <Border Grid.Row="4" Background="White" CornerRadius="11" BorderBrush="#E5E5EA"
            BorderThickness="1" Padding="15,10" Margin="0,11,0,0">
      <StackPanel>
        <TextBlock x:Name="DetailTitle" Text="Select an app to see its details" Foreground="#1D1D1F"
                   FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="DetailText" Text="Items turned off here are backed up and can be restored."
                   Foreground="#6E6E73" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="5" Margin="0,11,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button x:Name="DisableButton" Grid.Column="0" Content="Turn off" Width="118"
              Style="{StaticResource RoundedButton}" Background="#007AFF" Foreground="White"
              BorderThickness="0" Margin="0,0,9,0"/>
      <Button x:Name="EnableButton" Grid.Column="1" Content="Turn on" Width="118"
              Style="{StaticResource RoundedButton}"/>
      <TextBlock x:Name="StatusText" Grid.Column="2" Foreground="#8E8E93" FontSize="11"
                 HorizontalAlignment="Right" VerticalAlignment="Center" Text="Ready"/>
    </Grid>
  </Grid>
</Window>
